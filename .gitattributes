# Linux 上必须 LF —— CRLF 的 shell 脚本在 bash 里会报
#   "set: pipefail: invalid option name" / "syntax error near unexpected token"
# 这项目主要在 Linux 上跑, 强制 LF。
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.service text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
*.md text eol=lf
