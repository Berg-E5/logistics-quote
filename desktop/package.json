{
  "name": "logistics-quote-desktop",
  "version": "1.5.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "物流报价强制中央服务器 Windows 客户端",
  "main": "main.js",
  "author": "Berg-E5",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --config.electronDist=node_modules/electron/dist",
    "dist:dir": "electron-builder --win dir --config.electronDist=node_modules/electron/dist"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "@electron/universal": {
      "minimatch": "11.0.1"
    },
    "app-builder-lib": {
      "minimatch": "11.0.1"
    }
  },
  "build": {
    "appId": "com.berg.logisticsquote",
    "productName": "物流报价",
    "executableName": "LogisticsQuote",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "setup.js",
      "connection.html",
      "connection.js",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LogisticsQuote-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
