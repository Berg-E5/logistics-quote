[Unit]
Description=物流报价网站后端 (Node)
Documentation=https://quote.byberg.store
After=network.target

[Service]
Type=simple
User=quote
Group=quote
WorkingDirectory=/var/www/quote.byberg.store
ExecStart=/usr/bin/node server/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=8792
Environment=HOST=127.0.0.1
Environment=QUOTE_PYTHON=/var/www/quote.byberg.store/.venv/bin/python
Environment=QUOTE_IMPORT_CONCURRENCY=1
Environment=QUOTE_IMPORT_PREVIEW_MINUTES=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
SystemCallArchitectures=native
ReadWritePaths=/var/www/quote.byberg.store/data /var/www/quote.byberg.store/data_v2.js /var/www/quote.byberg.store/public/data_v2.js
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
